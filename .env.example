# 首次启动解析 main；从 /health 取得 model_revision 后固定为该提交 SHA。
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_MODEL_REVISION=main
# 留空时 CustomVoice 使用 vivian；Base 使用配置文件中的第一个音色。
TTS_DEFAULT_VOICE=
# Base 多音色配置；不设置时沿用单个 voice.wav + voice.txt，名称为 clone。
TTS_VOICES_FILE=
# TTS_VOICES_FILE=/references/voices.json

# hfd 下载的完整模型目录也可直接加载。先将宿主机模型目录挂载到 /models。
# TTS_MODEL=/models/Qwen3-TTS-12Hz-0.6B-CustomVoice
# 本地目录模式按文件内容生成版本哈希，TTS_MODEL_REVISION 不参与加载。

# 默认仅本机访问；远端客户端直连时改成 0.0.0.0，并在部署环境控制访问。
TTS_BIND_ADDRESS=127.0.0.1
TTS_PORT=8000

TTS_CHUNK_SIZE=8
TTS_MAX_NEW_TOKENS=1024
TTS_MAX_SEQ_LEN=2048
TTS_CACHE_TTL_SECONDS=300
# 网关磁盘缓存挂载目录，可改为 /data/qwen3-tts/cache；容器内为 /cache/audio。
TTS_CACHE_HOST_DIR=./cache
# 磁盘 PCM 缓存与活跃任务预留容量上限，不是内存上限。
TTS_CACHE_MAX_BYTES=268435456
TTS_MAX_OUTPUT_BYTES=8388608
TTS_MAX_PENDING_TASKS=8
TTS_MAX_READERS=256
TTS_TASK_TIMEOUT_SECONDS=120
TTS_SEND_TIMEOUT_SECONDS=15
TTS_CACHE_CLEANUP_SECONDS=5
