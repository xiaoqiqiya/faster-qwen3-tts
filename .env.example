# hfd 下载后的宿主机目录映射到 /models。
TTS_MODEL_HOST_DIR=/data/qwen3-tts/models
TTS_MODEL=/models/Qwen3-TTS-12Hz-0.6B-CustomVoice
# 也可填写 Hugging Face ID，由后端下载；仅该模式使用 revision。
TTS_MODEL_REVISION=main
TTS_DEFAULT_VOICE=vivian
# Base 使用该文件，CustomVoice 不读取。
TTS_VOICES_FILE=/references/voices.json

# 镜像部署必填，例如 ghcr.io/你的用户名/你的仓库名（全部小写）；源码构建无需填写。
TTS_IMAGE_PREFIX=
# 迁移分支独立标签；固定版本可填 sha-完整提交SHA。
TTS_IMAGE_TAG=vllm-omni
TTS_BIND_ADDRESS=127.0.0.1
TTS_PORT=8000

# 两端必须一致；不同文本并行提交给 vLLM-Omni 调度。
TTS_MAX_CONCURRENT_TASKS=8
# 并发槽位之外的等待数；0 表示不排队。
TTS_MAX_PENDING_TASKS=16
# 每阶段比例，两个阶段合计约 0.6，另需运行时余量。
TTS_GPU_MEMORY_UTILIZATION=0.3
TTS_MAX_NEW_TOKENS=1024

TTS_CACHE_HOST_DIR=./cache
# 单位 MB，1 MB = 1024 * 1024 字节。
TTS_CACHE_MAX_MB=256
TTS_CACHE_TTL_SECONDS=300
TTS_MAX_READERS=256
# 共享任务总时限，包含排队、推理和磁盘写入。
TTS_TASK_TIMEOUT_SECONDS=120
TTS_SEND_TIMEOUT_SECONDS=15
TTS_CACHE_CLEANUP_SECONDS=5
